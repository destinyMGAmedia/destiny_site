// ─────────────────────────────────────────────
// DESTINY NATION — THE GATEKEEPERS COMMISSION
// See spec/destiny-nation-landing.md
// ─────────────────────────────────────────────

model DestinyNationContribution {
  id            String             @id @default(cuid())
  reference     String             @unique // Flutterwave tx_ref, Paystack DVA reference, or a manual reference for bank-transfer-era rows
  package       GivingPackage
  tier          String // e.g. "GATEKEEPER_FRIEND" (ladder) or "BRONZE" (Founders' Circle)
  amount        Int // whole units in the chosen currency
  currency      String             @default("NGN")
  status        ContributionStatus @default(PENDING)
  donorName     String
  donorEmail    String
  donorPhone    String?
  donorCountry  String?
  donorOrg      String?
  isPledge      Boolean            @default(false) // >=10M ladder tiers AND all Founders' Circle tiers — lead-capture, no checkout
  isManualEntry Boolean            @default(false) // bank-transfer stopgap row, entered by hand pending Flutterwave go-live
  followUpNotes String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  // Paystack Dedicated Virtual Account — one fresh DVA per contribution (not shared), so a
  // webhook credit can be matched to exactly one row by account number, no narration parsing
  // needed. See spec/destiny-nation-landing.md §3 (interim Paystack DVA path).
  paystackCustomerCode String?
  dvaBankName          String?
  dvaAccountNumber     String? @unique
  dvaAccountName       String?

  @@index([status])
  @@index([package, tier])
}

// Singleton (one row) — the church's own settlement bank account + the Paystack subaccount
// created for it. Set up once by a Global/Super Admin; every contribution's per-gift DVA is
// created with `subaccount` pointing at subaccountCode, so 100% of each deposit settles
// directly to the church's own bank account, never the platform's.
model NationPaymentSettings {
  id             String   @id @default(cuid())
  bankCode       String
  bankName       String
  accountNumber  String
  accountName    String // resolved from Paystack at setup time, confirms the account is correct
  subaccountCode String // Paystack subaccount_code, e.g. "ACCT_xxxxxxxxxxxx"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum GivingPackage {
  LADDER // Package A — Gatekeeper Giving Ladder, project-tied
  FOUNDERS_CIRCLE // Package B — endowment-level, separate program
}

enum ContributionStatus {
  PENDING
  SUCCESS
  FAILED
  PLEDGED // lead-capture/large-gift path, before any money moves
}

// ─────────────────────────────────────────────
// THE YELLOW PAGES — public skills/business directory.
// See spec/theyellowpages.md. Public, unauthenticated read/write surface:
// listings auto-publish (isActive gate only, no approval queue) and ratings
// are deduped by hashed contact, never by login.
// ─────────────────────────────────────────────

model YellowPagesListing {
  id                String              @id @default(cuid())
  listingType       ListingType
  name              String // business/org name, or the person's display name for a skill listing
  contactPersonName String? // principal/contact full name — required for BUSINESS, mirrors `name` for INDIVIDUAL
  position          String? // "CEO", "Founder", etc. — BUSINESS only
  phone             String
  whatsapp          String? // only if different from phone
  email             String?
  category          YellowPagesCategory
  subCategory       String? // free-text profession/sub-sector, e.g. "Travel Agency"
  description       String // ~150 words; capped server-side regardless of client validation
  servicesOffered   String? // BUSINESS: main services/products, short text
  headline          String? // INDIVIDUAL: professional headline / tagline (e-resume)
  resumeSummary     String? // INDIVIDUAL: professional summary paragraph — distinct from the public `description`
  bannerImageUrl    String? // portfolio cover image, both types
  availability      String? // INDIVIDUAL: e.g. "Freelance / contract", "Full-time"
  openToWork        Boolean             @default(false) // INDIVIDUAL: availability badge
  skills            String[]            @default([]) // INDIVIDUAL: skill tags (individual analogue of servicesOffered)
  languages         String[]            @default([]) // INDIVIDUAL: spoken/written languages
  experience        Json                @default("[]") // [{ title, organization, location, startDate, endDate, current, description }]
  education         Json                @default("[]") // [{ school, degree, field, startYear, endYear, description }]
  projects          Json                @default("[]") // [{ name, role, url, description, imageUrls: [] }] — both types
  team              Json                @default("[]") // BUSINESS: [{ name, role, photoUrl, linkedListingId? }]
  editContacts      String[]            @default([]) // extra emails/phones authorized to request an edit OTP
  editStrict        Boolean             @default(false) // when true, the public phone/email do NOT grant edit access — only editContacts
  city              String?
  state             String?
  country           String?
  countryDialCode   String? // E.164 calling code (digits only, e.g. "234"), derived from `country` at write time — reused for wa.me / tel: links and display
  assemblyId        String?
  assembly          Assembly?           @relation(fields: [assemblyId], references: [id], onDelete: SetNull)
  memberId          String?
  member            Member?             @relation(fields: [memberId], references: [id], onDelete: SetNull)
  website           String?
  socialLinks       Json                @default("{}") // { facebook, instagram, linkedin, tiktok, ... }
  yearsInOperation  Int?
  certifications    String?
  logoUrl           String?
  photoUrl          String?
  portfolioImages   String[]            @default([]) // work/personal photos for the timeline feed — images only, no video
  licenseNumber     String?
  preferredContact  PreferredContact    @default(PHONE)
  isActive          Boolean             @default(true) // admin hide/deactivate flips this; excluded from all public queries when false
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  ratings           YellowPagesRating[]
  editOtps          YellowPagesEditOtp[]

  @@index([category])
  @@index([assemblyId])
  @@index([isActive])
  @@index([listingType])
}

model YellowPagesRating {
  id           String             @id @default(cuid())
  listingId    String
  listing      YellowPagesListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  stars        Int // 1–5, validated server-side
  comment      String?
  reviewerName String
  contactHash  String // sha256 of normalized phone-or-email — dedupe key only, raw contact is never persisted
  createdAt    DateTime           @default(now())

  @@unique([listingId, contactHash])
}

// Loginless owner-edit verification. A code is sent to a contact already on file for the
// listing (its phone/email, or an entry in `editContacts`); verifying it yields a short-lived
// edit token (the row id) accepted by PATCH /api/yellowpages/listings/[id] within
// EDIT_TOKEN_WINDOW_MINUTES. Raw contact / code are never persisted — only salted hashes.
model YellowPagesEditOtp {
  id          String             @id @default(cuid())
  listingId   String
  listing     YellowPagesListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  channel     OtpChannel
  contactHash String // hashContact(normalized target phone/email)
  codeHash    String // salted sha256 of the 6-digit code
  expiresAt   DateTime
  consumedAt  DateTime? // set on successful verify; presence + recency = a valid edit token
  attempts    Int                @default(0)
  createdAt   DateTime           @default(now())

  @@index([listingId, contactHash])
}

enum OtpChannel {
  EMAIL
  SMS
}

enum ListingType {
  INDIVIDUAL
  BUSINESS
}

enum PreferredContact {
  PHONE
  WHATSAPP
  EMAIL
}

enum YellowPagesCategory {
  TOURISM_TRAVEL
  CONSTRUCTION_REAL_ESTATE
  EDUCATION_TRAINING
  FINANCE_INSURANCE
  HEALTH_WELLNESS
  FOOD_HOSPITALITY
  TECHNOLOGY_IT
  CREATIVE_MEDIA
  FASHION_BEAUTY
  LEGAL_PROFESSIONAL_SERVICES
  TRANSPORT_LOGISTICS
  RETAIL_ECOMMERCE
  HOME_SERVICES_TRADES // plumbing, carpentry, electrical, etc.
  AGRICULTURE_FOOD_PRODUCTION
  EVENTS_ENTERTAINMENT
  OTHER
}
