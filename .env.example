# ─────────────────────────────────────────────
# DATABASE — Vercel Postgres (Neon)
# Get these from: Vercel Dashboard → Storage → Postgres → .env.local tab
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ─────────────────────────────────────────────
# NEXTAUTH
# NEXTAUTH_SECRET: run `openssl rand -base64 32` to generate
# NEXTAUTH_URL: your deployed URL (or http://localhost:3000 for dev)
# ─────────────────────────────────────────────
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────
# CLOUDINARY
# Get these from: cloudinary.com → Dashboard
# ─────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ─────────────────────────────────────────────
# YOUTUBE (optional — needed for dynamic playlist fetching)
# Get from: console.cloud.google.com → YouTube Data API v3
# Not needed for simple embeds
# ─────────────────────────────────────────────
YOUTUBE_API_KEY="your-youtube-api-key"

# ─────────────────────────────────────────────
# GLOBAL ADMIN SEED (used only during initial setup)
# ─────────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@destinymissions.org"
SEED_ADMIN_PASSWORD="global123"
SEED_ADMIN_NAME="Global Administrator"

# ─────────────────────────────────────────────
# DESTINY NATION — subdomain, giving, notifications
# See spec/destiny-nation-landing.md §1, §3
# ─────────────────────────────────────────────
# Host that src/proxy.js rewrites to /nation/* — defaults to nation.destinymissionglobal.org
NATION_HOST="nation.destinymissionglobal.org"
# Absolute URL used by main-site nav/banner links until the subdomain's DNS is live — omit to fall back to in-app /nation
NEXT_PUBLIC_NATION_URL=""
# Flutterwave Standard Checkout — from dashboard.flutterwave.com → Settings → API Keys
FLUTTERWAVE_SECRET_KEY=""
# Where pledge/large-gift leads and manual bank-transfer confirmations get emailed
DESTINY_NATION_NOTIFY_EMAIL=""
# Bank-transfer stopgap details shown on /nation/partner until Flutterwave KYC clears (Phase 1a)
NATION_BANK_ACCOUNT_NAME=""
NATION_BANK_NAME=""
NATION_BANK_ACCOUNT_NUMBER=""
# Paystack — interim giving path while Flutterwave's KYC is pending (per-gift Dedicated Virtual
# Accounts, DVA-only — never card checkout, since card billing descriptors would show the
# verified merchant's name, not "Destiny Nation"). Same key used for the webhook signature.
PAYSTACK_SECRET_KEY=""

# ─────────────────────────────────────────────
# THE YELLOW PAGES — public skills/business directory subdomain
# See spec/theyellowpages.md
# ─────────────────────────────────────────────
# Host that src/proxy.js rewrites to /yellowpages/* — defaults to theyellowpages.destinymissionglobal.org
YELLOWPAGES_HOST="theyellowpages.destinymissionglobal.org"
# Owner-edit OTP is verified by EMAIL only (uses RESEND_API_KEY above). SMS is not wired; this
# var + src/lib/yellowpages/sms.js are a stub for a future SMS channel. Leave blank.
SMS_PROVIDER=""
